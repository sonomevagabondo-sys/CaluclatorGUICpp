  <property name="styleSheet">
   <string notr="true">/* Sfondo della finestra */
QWidget {
    background-color: #202020;
    color: #ffffff;
    font-family: &quot;Segoe UI&quot;, sans-serif;
}

/* Display del display/input */
QLineEdit {
    background-color: #202020;
    color: #ffffff;
    border: none;
    font-size: 32px;
    padding: 10px;
}

/* Tutti i pulsanti (Stile Base) */
QPushButton {
    background-color: #2d2d2d;
    color: #ffffff;
    border: 1px solid #3b3b3b;
    border-radius: 8px;
    font-size: 18px;
    font-weight: bold;
}

/* Effetto al passaggio del mouse (Numeri e tasti generici) */
QPushButton:hover {
    background-color: #3b3b3b;
    border-color: #4a4a4a;
}

/* Effetto al click (Numeri e tasti generici) */
QPushButton:pressed {
    background-color: #1f1f1f;
    border-color: #2d2d2d;
    color: #cccccc;
}

/* ---------------- OPERATORI (+, -, X, /) ---------------- */
QPushButton[text=&quot;/&quot;], QPushButton[text=&quot;X&quot;], 
QPushButton[text=&quot;-&quot;], QPushButton[text=&quot;+&quot;] {
    background-color: #383838;
    border-color: #454545;
}

QPushButton[text=&quot;/&quot;]:hover, QPushButton[text=&quot;X&quot;]:hover, 
QPushButton[text=&quot;-&quot;]:hover, QPushButton[text=&quot;+&quot;]:hover {
    background-color: #454545;
    border-color: #555555;
}

QPushButton[text=&quot;/&quot;]:pressed, QPushButton[text=&quot;X&quot;]:pressed, 
QPushButton[text=&quot;-&quot;]:pressed, QPushButton[text=&quot;+&quot;]:pressed {
    background-color: #2a2a2a;
    border-color: #333333;
}

/* ---------------- TASTO DELETE ---------------- */
QPushButton[text=&quot;Delete&quot;] {
    background-color: #b5311b;
    border-color: #c93b23;
}

QPushButton[text=&quot;Delete&quot;]:hover {
    background-color: #c93b23;
    border-color: #d94830;
}

QPushButton[text=&quot;Delete&quot;]:pressed {
    background-color: #8f2413;
    border-color: #781d0e;
}

/* ---------------- TASTO UGUALE (=) ---------------- */
QPushButton[text=&quot;=&quot;] {
    background-color: #0078d4;
    border-color: #1084df;
}

QPushButton[text=&quot;=&quot;]:hover {
    background-color: #106ebe;
    border-color: #267cc9;
}

QPushButton[text=&quot;=&quot;]:pressed {
    background-color: #005a9e;
    border-color: #004578;
}

/* Layout */
QWidget#centralwidget {
    padding: 12px;
}</string>
